# Compiled binaries & artifacts
hashize
*.x
*.x.c
*.out
*.o
*.so
*.a

# Allow pre-built static binary (shc wrapper; needs /bin/bash at runtime)
!hashize_static

# Backup & temporary test files
*.bak
*.backup
*~
hashize_test.sh
*.tmp
*.temp

# OS & Editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
